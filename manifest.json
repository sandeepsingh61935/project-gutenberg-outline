{
  "manifest_version": 3,
  "name": "Project Gutenberg Outline",
  "version": "1.0.0",
  "description": "Outline + timeline scrubber + built-in dark mode for Project Gutenberg books.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "Project Gutenberg Outline"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "*://*.gutenberg.org/cache/epub/*/*.html*",
        "*://*.gutenberg.org/files/*/*.htm*"
      ],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "project-gutenberg-outline@sandeepsingh61935.github.io",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
